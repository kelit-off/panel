APP_ENV=production
APP_DEBUG=false
APP_KEY=
APP_THEME=pterodactyl
APP_TIMEZONE=America/New_York
APP_CLEAR_TASKLOG=720
APP_DELETE_MINUTES=10
APP_ENVIRONMENT_ONLY=true
LOG_CHANNEL=daily
APP_LOCALE=en
APP_URL=http://panel.example.com

DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=panel
DB_USERNAME=pterodactyl
DB_PASSWORD=

HASHIDS_SALT=
HASHIDS_LENGTH=8

MAIL_DRIVER=smtp
MAIL_HOST=smtp.example.com
MAIL_PORT=25
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_ENCRYPTION=tls
MAIL_FROM=no-reply@example.com
MAILGUN_ENDPOINT=api.mailgun.net
# You should set this to your domain to prevent it defaulting to 'localhost', causing
# mail servers such as Gmail to reject your mail.
#
# @see: https://github.com/pterodactyl/panel/pull/3110
# SERVER_NAME=panel.example.com

QUEUE_HIGH=high
QUEUE_STANDARD=standard
QUEUE_LOW=low

# Stripe keys for the storefront's checkout (Laravel Cashier). Use the "test mode"
# keys from the Stripe dashboard while developing. STRIPE_WEBHOOK_SECRET comes from
# the webhook endpoint you configure in Stripe pointing at /stripe/webhook.
STRIPE_KEY=
STRIPE_SECRET=
STRIPE_WEBHOOK_SECRET=

# Days a server is kept (suspended) before being deleted, counted from a failed
# renewal payment or from the end of the subscription.
BILLING_SUSPENSION_GRACE_DAYS=7
BILLING_CANCELLATION_GRACE_DAYS=3

# Search engines. Pages are only offered to search engines when APP_ENV=production
# (set SEO_INDEXABLE=true or false to force it). Paste the "content" value of the
# HTML meta tag given by Google Search Console and Bing Webmaster Tools to verify
# the site. Prices in structured data use STOREFRONT_CURRENCY (ISO 4217).
# SEO_INDEXABLE=true
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
STOREFRONT_CURRENCY=EUR
